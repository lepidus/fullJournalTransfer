#!/usr/bin/env php
<?php

declare(strict_types=1);

if ($argc !== 2 || !is_dir($argv[1]) || is_link($argv[1])) {
    fwrite(STDERR, "Usage: sanitize-files <journal-files-directory>\n");
    exit(1);
}

$root = realpath($argv[1]);
if ($root === false) {
    fwrite(STDERR, "Journal files directory is invalid\n");
    exit(1);
}
$preserved = [
    'issues/1/public/reference-issue.pdf',
    'articles/2/reference-discussion.txt',
];
$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS)
);
foreach ($iterator as $item) {
    if ($item->isLink()) {
        fwrite(STDERR, "Journal files directory contains a symbolic link\n");
        exit(1);
    }
    if (!$item->isFile()) {
        continue;
    }
    $relativePath = substr($item->getPathname(), strlen($root) + 1);
    if (in_array($relativePath, $preserved, true)) {
        continue;
    }
    $contents = 'Synthetic fixture file ' . hash('sha256', $relativePath) . PHP_EOL;
    if (file_put_contents($item->getPathname(), $contents) === false) {
        fwrite(STDERR, "Unable to sanitize fixture file\n");
        exit(1);
    }
}
